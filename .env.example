# LLM configuration.
# Copy this file to .env and fill in LLM_API_KEY. Local startup reads .env automatically.
# If LLM_API_KEY is empty, the app runs in offline rule-only/local-chat mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# Optional runtime overrides
APP_PORT=8080

# MySQL
DB_URL=jdbc:mysql://localhost:3306/agent_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=agent
DB_PASSWORD=agent123456

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_ENABLED=true

# Milvus (optional; set MILVUS_ENABLED=true to use Milvus as RAG vector store)
MILVUS_ENABLED=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=agent_platform_embeddings
MILVUS_DATABASE_NAME=
MILVUS_USERNAME=
MILVUS_PASSWORD=
